{
  "name": "test-container-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "check": "bun run lint && bun run typecheck && bun run test",
    "cli": "bun --no-env-file packages/cli/dist/index.js",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
